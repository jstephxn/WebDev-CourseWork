{{> head}}
{{> header}}

<link rel="stylesheet" href="/static/styles.css"/>

<main class="courses-page">

  <!-- ===== FILTER BAR ===== -->
  <section class="filters">
    <form method="GET" action="/courses" class="filters-form">

      <select name="level" class="input">
        <option value="" {{^filters.level}}selected{{/filters.level}}>All Levels</option>
        <option value="beginner" {{#isBeginner}}selected{{/isBeginner}}>Beginner</option>
        <option value="intermediate" {{#isIntermediate}}selected{{/isIntermediate}}>Intermediate</option>
        <option value="advanced" {{#isAdvanced}}selected{{/isAdvanced}}>Advanced</option>
      </select>

      <input
        type="search"
        name="q"
        value="{{filters.q}}"
        placeholder="Search courses..."
        class="input search"
      />

      <button class="btn primary" type="submit">Apply</button>
      <a href="/courses" class="btn">Reset</a>

    </form>
  </section>

  <!-- ===== COURSE GRID ===== -->
  <section class="cards">

    {{#courses}}
    <article class="card">

      <div class="card-header">
        <h2>{{title}}</h2>
        <span class="badge {{level}}">{{level}}</span>
      </div>

      <p class="muted">
        {{type}} {{#allowDropIn}}• Drop-in available{{/allowDropIn}}
      </p>

      <p class="description">{{description}}</p>

      <div class="card-meta">
        <p>📅 {{startDate}} – {{endDate}}</p>
        <p>🧘 Sessions: {{sessionsCount}}</p>
        <p>⏱ Next: {{nextSession}}</p>
      </div>

      <!-- ===== ACTIONS ===== -->
      <div class="card-actions">
        <a href="/courses/{{id}}" class="btn primary">
          View & Book
        </a>

        {{#isInstructor}}
          <form method="POST" action="/admin/courses/{{id}}/delete">
            <button
              type="submit"
              class="btn danger"
              onclick="return confirm('Delete this course?')">
              Delete
            </button>
          </form>
        {{/isInstructor}}
      </div>

    </article>
    {{/courses}}

    {{^courses}}
      <p class="empty-state">No courses match your filters.</p>
    {{/courses}}

  </section>

  <!-- ===== PAGINATION ===== -->
  <nav class="pagination">

    {{#pagination.hasPrev}}
      <a href="{{pagination.prevLink}}" class="btn">← Previous</a>
    {{/pagination.hasPrev}}

    <span class="muted">
      Page {{pagination.page}} of {{pagination.totalPages}}
    </span>

    {{#pagination.hasNext}}
      <a href="{{pagination.nextLink}}" class="btn">Next →</a>
    {{/pagination.hasNext}}

  </nav>

</main>

{{> footer}}