{{> head}}
{{> header}}

<link rel="stylesheet" href="/static/styles.css"/>

<main class="admin-page">

  <section class="form-card">

    <h1>Create Course</h1>
    <p class="muted">Add a new yoga course to the system</p>

    <form method="POST" action="/admin/courses" class="form">

      <div class="form-group">
        <label>Title</label>
        <input name="title" required placeholder="e.g. Morning Flow Yoga" />
      </div>

      
      <div class="form-group">
        <label>Level</label>
        <select name="level">
          <option value="">Select level</option>
          <option value="beginner">Beginner</option>
          <option value="intermediate">Intermediate</option>
          <option value="advanced">Advanced</option>
        </select>
      </div>

      
      <div class="form-group">
        <label>Type</label>
        <select name="type">
          <option value="WEEKLY_BLOCK">Weekly Block</option>
          <option value="WEEKEND_WORKSHOP">Weekend Workshop</option>
        </select>
      </div>

      
      <div class="form-group checkbox">
        <input type="checkbox" name="allowDropIn" value="true" id="dropin"/>
        <label for="dropin">Allow drop-in booking</label>
      </div>

      
      <div class="form-row">
        <div class="form-group">
          <label>Start Date</label>
          <input type="date" name="startDate" />
        </div>

        <div class="form-group">
          <label>End Date</label>
          <input type="date" name="endDate" />
        </div>
      </div>

      
      <div class="form-group">
        <label>Description</label>
        <textarea name="description" rows="4" placeholder="Describe the course..."></textarea>
      </div>

      
      <div class="form-actions">
        <button class="btn primary" type="submit">
          Create Course
        </button>

        <a href="/courses" class="btn">Cancel</a>
      </div>

    </form>

  </section>

</main>

{{> footer}}