{{> head}}
{{> header}}

<link rel="stylesheet" href="/static/styles.css"/>

<main class="admin-page">

  <!-- ===== HEADER ===== -->
  <section class="admin-header">
    <h1>Session Participants</h1>

    <a href="/courses" class="btn">
      ← Back to Courses
    </a>
  </section>

  <!-- ===== TABLE ===== -->
  <section class="table-card">

    <table class="table">

      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Status</th>
        </tr>
      </thead>

      <tbody>

        {{#participants}}
        <tr>

          <td>{{name}}</td>
          <td>{{email}}</td>

          <td>
            <span class="status-badge {{status}}">
              {{status}}
            </span>
          </td>

        </tr>
        {{/participants}}

        {{^participants}}
        <tr>
          <td colspan="3" class="empty-state">
            No participants yet
          </td>
        </tr>
        {{/participants}}

      </tbody>

    </table>

  </section>

</main>

{{> footer}}