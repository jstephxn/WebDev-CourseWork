{{> head}}
{{> header}}

<link rel="stylesheet" href="/static/styles.css"/>

<main class="auth-page">

  <section class="form-card auth-card">

    <h1>Login</h1>
    <p class="muted">Access your account</p>

    <form method="POST" action="/auth/login" class="form">

      <!-- EMAIL -->
      <div class="form-group">
        <label for="email">Email</label>
        <input 
          id="email"
          name="email" 
          type="email"
          placeholder="you@example.com"
          required 
        />
      </div>

      <!-- PASSWORD -->
      <div class="form-group">
        <label for="password">Password</label>
        <input 
          id="password"
          name="password" 
          type="password"
          placeholder="Enter your password"
          required 
        />
      </div>

      <!-- SHOW PASSWORD -->
      <div class="form-group checkbox">
        <label for="showPw">Show Password</label>
        <input type="checkbox" onclick="togglePassword()" id="showPw"/>
        
      </div>

      <!-- ERROR -->
      {{#error}}
        <p class="error">{{error}}</p>
      {{/error}}

      <!-- ACTIONS -->
      <div class="form-actions">
        <button class="btn primary" type="submit">
          Login
        </button>
      </div>

      <!-- EXTRA -->
      <p class="muted">
        Don’t have an account? 
        <a href="/register">Register</a>
      </p>

    </form>

  </section>

</main>

<script>
function togglePassword(){
  const pw = document.getElementById("password");
  pw.type = pw.type === "password" ? "text" : "password";
}
</script>

{{> footer}}