{{> head}}
{{> header}}
<link rel="stylesheet" href="/static/styles.css"/>

<main class="home-page">

  <!-- HERO -->
  <section class="hero">
    <img src="/static/images/YogaBanner.png" class="hero-img"/>

    <div class="hero-content">
      <h1>Welcome to Yoga Studio</h1>
      <p>Find your balance, build strength, and reconnect with yourself.</p>

      <a href="/courses" class="btn primary hero-btn">
        View Our Courses
      </a>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about-section">
    <div class="about-card">
      <h2>About Us</h2>

      <p>
        At our yoga studio, we believe in creating a welcoming space where everyone can reconnect 
        with their body, mind, and breath. Whether you're a complete beginner or an experienced 
        practitioner, our classes are designed to support your personal journey toward balance, 
        strength, and inner calm.
      </p>

      <p>
        Guided by passionate instructors, we focus on mindful movement, relaxation, and holistic 
        wellbeing—helping you leave each session feeling refreshed, grounded, and empowered.
      </p>
    </div>
  </section>

</main>

{{> footer}}

