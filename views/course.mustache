{{> head}}
{{> header}}

<article class="course-page">

  <!-- ===== COURSE HEADER ===== -->
  <section class="course-header">
    <h1>{{course.title}}</h1>

    <p class="muted">
      Level: {{course.level}} • Type: {{course.type}}
      {{#course.allowDropIn}}• Drop-in available{{/course.allowDropIn}}
    </p>

    <p class="course-description">{{course.description}}</p>
    <p class="muted">Dates: {{course.startDate}} – {{course.endDate}}</p>
  </section>

  <!-- ===== COURSE BOOKING ===== -->
  <section class="course-booking">
    <h2>Book the full course</h2>

    {{#user}}

      <div class="booking-actions">

        {{#course.isBooked}}
          <button class="btn booked" disabled>Already Booked</button>
        {{/course.isBooked}}

        {{^course.isBooked}}
          <a href="/courses/{{course._id}}/book" class="btn primary">
            Book full course
          </a>
        {{/course.isBooked}}

        {{#isInstructor}}
          <div class="admin-actions">
            <a href="/admin/courses/{{course._id}}/export" class="btn">
              Download Participants (CSV)
            </a>

            <a href="/admin/courses/{{course._id}}/edit" class="btn">
              Edit Course
            </a>
          </div>
        {{/isInstructor}}

      </div>

    {{/user}}

    {{^user}}
      <p class="muted">
        Please <a href="/login">login</a> to book this course.
      </p>
    {{/user}}
  </section>

  <!-- ===== SESSIONS ===== -->
  <section class="course-sessions">
    <h2>Sessions</h2>

    <table class="table">
      <thead>
        <tr>
          <th>Start</th>
          <th>End</th>
          <th>Capacity</th>
          <th>Booked</th>
          <th>Remaining</th>
          <th>Booking</th>

          {{#isInstructor}}
            <th>Admin</th>
          {{/isInstructor}}
        </tr>
      </thead>

      <tbody>
        {{#sessions}}
        <tr class="{{#isFull}}full{{/isFull}}">

          <td>{{start}}</td>
          <td>{{end}}</td>
          <td>{{capacity}}</td>
          <td>{{booked}}</td>
          <td>{{remaining}}</td>

          <!-- ===== BOOK SESSION ===== -->
          <td>

            {{#allowDropIn}}

              {{#user}}

                {{#isBooked}}
                  <span class="booked">Session Booked</span>
                {{/isBooked}}

                {{^isBooked}}
                  <form action="/sessions/{{id}}/book" method="POST">
                    <button class="btn" type="submit" {{#isFull}}disabled{{/isFull}}>
                      {{#isFull}}Full{{/isFull}}
                      {{^isFull}}Book Session{{/isFull}}
                    </button>
                  </form>
                {{/isBooked}}

              {{/user}}

              {{^user}}
                <span class="muted">
                  <a href="/login">Login to book</a>
                </span>
              {{/user}}

            {{/allowDropIn}}

            {{^allowDropIn}}
              <span class="muted">Drop-ins disabled</span>
            {{/allowDropIn}}

          </td>

          <!-- ===== ADMIN SESSION ACTIONS ===== -->
          {{#isInstructor}}
          <td class="admin-actions">

            <a href="/admin/sessions/{{id}}/participants" class="btn">
              Participants
            </a>

            <form method="POST" action="/admin/sessions/{{id}}/delete">
              <button
                type="submit"
                class="btn danger"
                onclick="return confirm('Delete this session?')">
                Delete
              </button>
            </form>

          </td>
          {{/isInstructor}}

        </tr>
        {{/sessions}}
      </tbody>
    </table>

    <!-- ===== ADD SESSION (ADMIN) ===== -->
    {{#user}}
      {{#isInstructor}}

      <div class="admin-form">
        <h3>Add Session</h3>

        <form method="POST" action="/admin/courses/{{course._id}}/sessions">

          <label>Start Date & Time</label>
          <input type="datetime-local" name="startDateTime" required>

          <label>End Date & Time</label>
          <input type="datetime-local" name="endDateTime" required>

          <label>Capacity</label>
          <input type="number" name="capacity" required>

          <button class="btn primary" type="submit">
            Create Session
          </button>

        </form>
      </div>

      {{/isInstructor}}
    {{/user}}

  </section>

</article>

{{> footer}}