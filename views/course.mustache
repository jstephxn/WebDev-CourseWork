{{> head}}
{{> header}}

<article>
  <h1>{{course.title}}</h1>

  <p class="muted">
    Level: {{course.level}} • Type: {{course.type}}
    {{#course.allowDropIn}}• Drop-in available{{/course.allowDropIn}}
  </p>

  <p>{{course.description}}</p>
  <p class="muted">Dates: {{course.startDate}} – {{course.endDate}}</p>

  <!-- 🔐 BOOK FULL COURSE -->
  <section>
    <h2>Book the full course</h2>
    {{#user}}
      <form action="/courses/{{course._id}}/book" method="POST">
        <button class="btn primary" type="submit">
          Book full course
        </button>
      </form>
      {{#isInstructor}}
        <!-- Changed from being taken to a new page (create_session.mustache) to add a new session to the session creation to be at the bottom of the table -->
        <!-- <a href="/admin/courses/{{course._id}}/sessions/new">Add Session</a> -->
        <a href="/admin/courses/{{course._id}}/export" class="btn"> Download Participants (CSV) </a>
        <a href="/admin/courses/{{course._id}}/edit" class="btn">Edit Course</a>
      {{/isInstructor}}
    {{/user}}

    {{^user}}
      <p>Please <a href="/login">login</a> to book this course.</p>
    {{/user}}
  </section>

  <!-- 📅 SESSIONS -->
  <section>
    <h2>Sessions</h2>

    <table class="table">
      <thead>
        <tr>
          <th>Start</th>
          <th>End</th>
          <th>Capacity</th>
          <th>Booked</th>
          <th>Remaining</th>
          <th>Drop in</th>

          {{#isInstructor}}
            <th>Admin Actions</th>
          {{/isInstructor}}

        </tr>
      </thead>

      <tbody>
        {{#sessions}}
        <tr>
          <td>{{start}}</td>
          <td>{{end}}</td>
          <td>{{capacity}}</td>
          <td>{{booked}}</td>
          <td>{{remaining}}</td>

          <td>
            {{#allowDropIn}}

              {{#user}}
                <form action="/sessions/{{id}}/book" method="POST" >
                  <button class="btn" type="submit" {{#isFull}}disabled{{/isFull}}>
                    Book this session
                  </button>
                </form>
    
              {{/user}}

              {{^user}}
                <span class="muted">
                  <a href="/login">Login to book</a>
                </span>
              {{/user}}

            {{/allowDropIn}}

            {{^allowDropIn}}
              <span class="muted">Drop-ins disabled</span>
            {{/allowDropIn}}
          </td>
          {{#isInstructor}}
              <td>
                <a href="/admin/sessions/{{id}}/participants" class="btn">View Participants</a>
                <form method="POST" action="/admin/sessions/{{id}}/delete" >
                  <button type="submit" class="btn" onclick="return confirm('Are you sure you want to delete this session?')">
                    Delete Session
                  </button>
                </form>
              </td>
            {{/isInstructor}}
        </tr>
        {{/sessions}}
      </tbody>
    </table>

    {{#user}}
      {{#isInstructor}}

        <h1>Add Session to {{course.title}}</h1>

        <form method="POST" action="/admin/courses/{{course._id}}/sessions">

          <label>Start Date & Time</label>
          <input type="datetime-local" name="startDateTime" required>

          <label>End Date & Time</label>
          <input type="datetime-local" name="endDateTime" required>

          <label>Capacity</label>
          <input type="number" name="capacity" required>

          <button type="submit">Create Session</button>

        </form>

      {{/isInstructor}}
    {{/user}}

  </section>
</article>

{{> footer}}