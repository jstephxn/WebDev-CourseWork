{{> head}}
{{> header}}

<article>
  <h1>{{course.title}}</h1>

  <p class="muted">
    Level: {{course.level}} • Type: {{course.type}}
    {{#course.allowDropIn}}• Drop-in available{{/course.allowDropIn}}
  </p>

  <p>{{course.description}}</p>
  <p class="muted">Dates: {{course.startDate}} – {{course.endDate}}</p>

  <!-- 🔐 BOOK FULL COURSE -->
  <section>
    <h2>Book the full course</h2>

    {{#user}}
      <form action="/courses/{{course._id}}/book" method="post">
        <button class="btn primary" type="submit">
          Book full course
        </button>
      </form>
    {{/user}}

    {{^user}}
      <p>Please <a href="/login">login</a> to book this course.</p>
    {{/user}}
  </section>

  <!-- 📅 SESSIONS -->
  <section>
    <h2>Sessions</h2>

    <table class="table">
      <thead>
        <tr>
          <th>Start</th>
          <th>End</th>
          <th>Capacity</th>
          <th>Booked</th>
          <th>Remaining</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        {{#sessions}}
        <tr>
          <td>{{start}}</td>
          <td>{{end}}</td>
          <td>{{capacity}}</td>
          <td>{{booked}}</td>
          <td>{{remaining}}</td>

          <td>
            {{#../course.allowDropIn}}

              {{#user}}
                <form method="post" action="/sessions/{{course_id}}/book">
                  <button class="btn" type="submit" {{#isFull}}disabled{{/isFull}}>
                    Book this session
                  </button>
                </form>
              {{/user}}

              {{^user}}
                <span class="muted">
                  <a href="/login">Login to book</a>
                </span>
              {{/user}}

            {{/../course.allowDropIn}}

            {{^../course.allowDropIn}}
              <span class="muted">Drop-ins disabled</span>
            {{/../course.allowDropIn}}
          </td>
        </tr>
        {{/sessions}}
      </tbody>
    </table>
  </section>
</article>

{{> footer}}