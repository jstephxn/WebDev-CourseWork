
{{> head}}
{{> header}}

<div class="booking-page">

  <h1>Book: {{course.title}}</h1>

  <p class="muted">
    Level: {{course.level}} • Type: {{course.type}}
    {{#course.allowDropIn}}• Drop-in available{{/course.allowDropIn}}
  </p>

  <p>{{course.description}}</p>

  {{#error}}
    <div class="alert error">{{error}}</div>
  {{/error}}

  <form method="POST" action="/courses/{{course.id}}/book" class="booking-form">

    <fieldset>
      <legend>Your details</legend>

      <div class="field">
        <label>Name</label>
        <input type="text" name="name" value="{{user.name}}" required>
      </div>

      <div class="field">
        <label>Email</label>
        <input type="email" name="email" value="{{user.email}}" required>
      </div>

      <div class="field">
        <label>Notes</label>
        <textarea name="notes" placeholder="Optional"></textarea>
      </div>

      <div class="field checkbox">
        <input type="checkbox" name="consent" required>
        <label>I agree to the booking terms</label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Booking summary</legend>

      <p>This course includes <strong>{{sessionsCount}}</strong> sessions:</p>

      <ul class="muted">
        {{#sessions}}
          <li>{{start}} ({{remaining}} places left)</li>
        {{/sessions}}
      </ul>
    </fieldset>

    <div class="actions">
      <button class="btn primary" type="submit">
        Confirm Booking
      </button>
      <a href="/courses/{{course.id}}" class="btn">Cancel</a>
    </div>

  </form>

</div>
{{> footer}}
