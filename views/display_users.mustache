{{> head}}
{{> header}}

<link rel="stylesheet" href="/static/styles.css"/>

<main class="admin-page">

  <!-- ===== HEADER ===== -->
  <section class="admin-header">
    <h1>All Users</h1>

    <a href="/admin/create_user" class="btn primary">
      + Create User
    </a>
  </section>

  <!-- ===== TABLE ===== -->
  <section class="table-card">

    <table class="table">

      <thead>
        <tr>
          <th>Email</th>
          <th>Name</th>
          <th>Role</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        {{#users}}
        <tr>

          <td>{{email}}</td>

          <td>{{name}}</td>

          <td>
            <span class="role-badge {{role}}">
              {{role}}
            </span>
          </td>

          <td class="actions">

            <a href="/admin/users/{{_id}}/edit" class="btn">
              Edit
            </a>

            <form method="POST" action="/admin/users/{{_id}}/delete_user">
              <button
                type="submit"
                class="btn danger"
                onclick="return confirm('Delete this user?')">
                Delete
              </button>
            </form>

          </td>

        </tr>
        {{/users}}

        {{^users}}
        <tr>
          <td colspan="4" class="empty-state">
            No users found.
          </td>
        </tr>
        {{/users}}
      </tbody>

    </table>

  </section>

</main>

{{> footer}}