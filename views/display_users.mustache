{{> head }}
{{> header }}

<h1> All Users: </h1>
<a href="/admin/create_user" class="btn primary"> Create User </a>
<table>
    <thead>
        <tr>
            <td><strong>Username</strong></td>
            <td><strong>Name</strong></td>
            <td><strong>Role</strong></td>
            <td><strong>ActionsUsername</strong></td>
        </tr>
    </thead>
        {{#users}}
        <tr>
        <td>{{email}}</td>
        <td>{{name}}</td>
        <td>{{role}}</td>
        <td>
            <form method="POST" action="/admin/{{_id}}/delete_user">
                <button type="submit" onclick="return confirm('Are you sure you want to delete this user?')" class="btn">Delete User</button>
            </form>
            <a href="/admin/users/{{_id}}/edit" class="btn">Edit User</a>
        </td>
        </tr>
        {{/users}}
    <tbody>
    </tbody>
</table>

{{> footer }}