{{> head}}
{{> header}}

<link rel="stylesheet" href="/static/styles.css"/>

<main class="admin-page">

  <section class="form-card">

    <h1>Edit User</h1>
    <p class="muted">Update user details</p>

    <form method="POST" action="/admin/users/{{user._id}}/update" class="form">

      <!-- NAME -->
      <div class="form-group">
        <label>Name</label>
        <input name="name" value="{{user.name}}" required />
      </div>

      <!-- EMAIL -->
      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" value="{{user.email}}" required />
      </div>

      <!-- PASSWORD -->
      <div class="form-group">
        <label>Password (leave blank to keep current)</label>
        <input name="password" type="password" id="password" />
      </div>

      <!-- CONFIRM PASSWORD -->
      <div class="form-group">
        <label>Confirm Password</label>
        <input name="confirmPassword" type="password" id="confirmPassword" />
      </div>

      <!-- SHOW PASSWORD -->
      <div class="form-group checkbox">
        <input type="checkbox" onclick="togglePassword()" id="showPw"/>
        <label for="showPw">Show Password</label>
      </div>

      <!-- ROLE -->
      <div class="form-group">
        <label>Role</label>
        <select name="role">
          <option value="student" {{#isStudent}}selected{{/isStudent}}>Student</option>
          <option value="instructor" {{#isInstructor}}selected{{/isInstructor}}>Instructor</option>
        </select>
      </div>

      <!-- ERROR -->
      {{#error}}
        <p class="error">{{error}}</p>
      {{/error}}

      <!-- ACTIONS -->
      <div class="form-actions">
        <button type="submit" class="btn primary">
          Update User
        </button>

        <a href="/admin/display_users" class="btn">
          Cancel
        </a>
      </div>

    </form>

  </section>

</main>

<script>
function togglePassword(){
  const pw = document.getElementById("password");
  const cpw = document.getElementById("confirmPassword");

  const type = pw.type === "password" ? "text" : "password";
  pw.type = type;
  cpw.type = type;
}
</script>

{{> footer}}